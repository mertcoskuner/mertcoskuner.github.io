---
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const items = [
  { href: "/", label: "Home" },
  { href: "/publications", label: "Publications" },
  { href: "/projects", label: "Projects" },
  { href: "/blog", label: "Blog" },
];
const current = (href) => (href === "/" ? path === "/" : path.startsWith(href));
---

<header class="site-header">
  <div class="wrap">
    {path !== "/" && (
      <a class="wordmark" href="/" aria-label="Mert Coşkuner, home">
        <img class="mark" src="/favicon.svg" alt="" width="32" height="32" />
        <span class="name">Mert Coşkuner</span>
      </a>
    )}
    <nav class="nav" aria-label="Main">
      {items.map((item) => (
        <a href={item.href} class={item.href === "/" ? "home" : undefined} aria-current={current(item.href) ? "page" : undefined}>{item.label}</a>
      ))}
      <button class="theme-toggle" type="button" aria-label="Switch colour theme" title="Switch colour theme">
        <svg class="moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
        <svg class="sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"></circle><path d="M12 2v2.2M12 19.8V22M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M2 12h2.2M19.8 12H22M4.9 19.1l1.6-1.6M17.5 6.5l1.6-1.6"></path></svg>
      </button>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var button = document.querySelector(".theme-toggle");
    if (!button) return;
    button.addEventListener("click", function () {
      var root = document.documentElement;
      var next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
      root.setAttribute("data-theme", next);
      try {
        localStorage.setItem("theme", next);
      } catch (e) {}
    });
  })();
</script>
