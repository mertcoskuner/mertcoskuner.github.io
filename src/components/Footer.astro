---
import { links, profile } from "../data/site.js";
import { external } from "../lib/links.js";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="cols">
      <div>
        <strong style="color: var(--text); font-weight: 560;">{profile.name}</strong>
        <p style="margin: 0.4rem 0 0; max-width: 26rem;">
          Trustworthy and efficient machine learning. MSc student at Sabancı University.
        </p>
      </div>
      <div>
        <h4 class="label">Site</h4>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/publications">Publications</a></li>
          <li><a href="/projects">Projects</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
      </div>
      <div>
        <h4 class="label">Elsewhere</h4>
        <ul>
          {links.map((link) => <li><a href={link.href} {...external(link.href)}>{link.label}</a></li>)}
        </ul>
      </div>
    </div>
    <div class="base mono">
      <span>© {year} {profile.name}</span>
      <span>{profile.location}</span>
    </div>
  </div>
</footer>
